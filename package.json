{
  "private": true,
  "scripts": {
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml --no-cache --max-concurrency 1",
    "eval:validate": "promptfoo validate config -c evals/promptfooconfig.yaml",
    "eval:view": "promptfoo view",
    "eval:report": "promptfoo eval -c evals/promptfooconfig.yaml --no-cache --max-concurrency 1 -o reports/promptfoo-report.html -o reports/promptfoo-results.json"
  },
  "devDependencies": {
    "promptfoo": "0.123.1"
  }
}
